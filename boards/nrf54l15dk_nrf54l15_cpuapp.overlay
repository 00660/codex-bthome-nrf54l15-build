#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		ntcpower = &ntc_power;
	};

	ntc_power_pins {
		compatible = "gpio-leds";

		ntc_power: ntc-power {
			gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
		};
	};

	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>;
	};
};

/*
 * P1.02(NFC1) / P1.03(NFC2) 复位后默认是 NFC 天线脚。
 * 模组第 8 脚 = P1.02，用来接 IP5328 的 KEY 网络，必须先把 NFC 关掉。
 * nfct-pins-as-gpios 会让构建系统定义 NRF_CONFIG_NFCT_PINS_AS_GPIOS，
 * SystemInit() 启动时自动清掉 NFC 的 PADCONFIG。
 */
&nfct {
	status = "disabled";
};

&uicr {
	nfct-pins-as-gpios;
};

&uart20 {
	status = "disabled";
};

&spi00 {
	status = "disabled";
};

&mx25r64 {
	status = "disabled";
};

&pwm20 {
	status = "disabled";
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <900>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN4>;
		zephyr,resolution = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <900>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_VDD>;
		zephyr,resolution = <12>;
	};

	/*
	 * 电池电压：模组第 4 脚 = P1.12 = AIN5。
	 * IP5328 的 I2C 读不到数据时的兜底数据源 —— 外部分压后接进来。
	 * nRF54L15 的 SAADC 只有 AIN0~AIN7 这 8 个脚能当模拟输入：
	 *   AIN0=P1.04 AIN1=P1.05 AIN2=P1.06 AIN3=P1.07
	 *   AIN4=P1.11 AIN5=P1.12 AIN6=P1.13 AIN7=P1.14
	 * P1.11 已经被 NTC 占了，P1.13/P1.14 被 I2C 占了，所以选 P1.12。
	 */
	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <900>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN5>;
		zephyr,resolution = <12>;
	};

	/*
	 * 充电器输入 VBUS：模组第 16 脚 = P1.07 = AIN3（可选接线）。
	 * 用来直接判断"插没插充电器"，比靠电池电压斜率猜靠谱得多。
	 *
	 *   充电器输入 VBUS ──[1MΩ]──┬── 模组第 16 脚
	 *                             └──[150kΩ]── GND
	 *
	 * 分压比约 7.67:1：5V→0.65V，9V→1.17V，12V→1.56V，20V→2.61V，
	 * 全部落在 SAADC 的 3.6V 满量程内。没接线时悬空，固件按"无输入"处理。
	 */
	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <900>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN3>;
		zephyr,resolution = <12>;
	};

};
