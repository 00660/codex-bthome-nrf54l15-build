#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		ntcpower = &ntc_power;
	};

	ntc_power_pins {
		compatible = "gpio-leds";

		ntc_power: ntc-power {
			gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
		};
	};

	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>;
	};
};

/*
 * P1.02(NFC1) / P1.03(NFC2) 复位后默认是 NFC 天线脚。
 * 模组第 8 脚 = P1.02，用来接 IP5328 的 KEY 网络，必须先把 NFC 关掉。
 * nfct-pins-as-gpios 会让构建系统定义 NRF_CONFIG_NFCT_PINS_AS_GPIOS，
 * SystemInit() 启动时自动清掉 NFC 的 PADCONFIG。
 */
&nfct {
	status = "disabled";
};

&uicr {
	nfct-pins-as-gpios;
};

&uart20 {
	status = "disabled";
};

&spi00 {
	status = "disabled";
};

&mx25r64 {
	status = "disabled";
};

&pwm20 {
	status = "disabled";
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <900>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN4>;
		zephyr,resolution = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <900>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_VDD>;
		zephyr,resolution = <12>;
	};

	/*
	 * 电池电压：模组第 4 脚 = P1.12 = AIN5，外部 1M+1M 分压后接进来。
	 *
	 * nRF54L15 的 SAADC 只有 AIN0~AIN7 这 8 个脚能当模拟输入：
	 *   AIN0=P1.04 AIN1=P1.05 AIN2=P1.06 AIN3=P1.07
	 *   AIN4=P1.11 AIN5=P1.12 AIN6=P1.13 AIN7=P1.14
	 * P1.11 被 NTC 占了，P1.14 被 VBUS 占了，所以电池电压选 P1.12。
	 */
	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <900>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN5>;
		zephyr,resolution = <12>;
	};

	/*
	 * 充电器输入 VBUS：模组第 6 脚 = P1.14 = AIN7。
	 * 用来直接判断"插没插充电器"，比靠电池电压斜率猜靠谱得多。
	 *
	 *   充电输入 5V ──[1MΩ]──┬── 模组第 6 脚
	 *                        └──[100kΩ]── GND     （再并一颗电容到 GND）
	 *
	 * 分压比约 11:1：5V→0.45V，9V→0.82V，12V→1.09V，20V→1.82V，
	 * 全部落在 SAADC 的 3.6V 满量程内，余量很大。
	 *
	 * 为什么用 6 脚而不是 16 脚：模组 5/6/7 这三个模拟脚现在都空着
	 * （5/6 原来是 I2C，7 原来是 IP5328 的 INT），6 脚就在已经焊好的
	 * 4 脚（电池）旁边，接线最顺手。16 脚当初只是因为 5/6/7 都被占了
	 * 才选的，现在没必要。
	 *
	 * 快充砍掉之后输入只可能是普通 5V，这一脚实测就两个状态：
	 *   插着 ≈ 418mV（反算 4.60V），没插 ≈ 327mV（反算 3.59V）。
	 * 固件按"反算回输入端的电压 > 3.6V 且 < 5V"判定，
	 * 见 src/main.c 的 VBUS_PRESENT_MIN_MV。
	 */
	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <900>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
	};

};
